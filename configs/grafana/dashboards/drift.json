{
  "uid": "pdm-drift",
  "title": "Predictive Maintenance: input drift",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Sensors drifted (|shift| > 0.5 training std)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pdm_drifted_sensors",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Observations in drift window",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pdm_drift_window_size",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Input shift by sensor (training std units)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pdm_input_shift_std",
          "legendFormat": "{{sensor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Current shift per sensor",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pdm_input_shift_std",
          "legendFormat": "{{sensor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -3,
          "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "type": "timeseries",
      "title": "Prediction requests per second",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total{handler=~\"/api/.*\"}[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Shift = mean of the last 200 observed sensor vectors minus the C-MAPSS FD001 training mean, in training standard deviations (no data until 20 observations). A shift means incoming data differs from the training population; in a turbofan fleet it also appears as engines age, so treat it as a prompt to investigate, not proof the model is wrong."
      }
    }
  ],
  "templating": {
    "list": []
  },
  "tags": [
    "drift"
  ]
}