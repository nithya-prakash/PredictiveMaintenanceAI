# Copy to .env and fill in. .env is never committed or copied into images.

# Required: password for the Postgres container (the API logs recommendations there).
POSTGRES_PASSWORD=

# Recommended: shared token so the dashboard is exempt from the API's per-IP rate
# limit (all dashboard users share one IP). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Required only for the optional monitoring profile (Grafana admin login).
GRAFANA_ADMIN_PASSWORD=

# Optional: browser origins allowed to call the API, as a JSON list.
# CORS_ORIGINS=["http://localhost:8501"]
